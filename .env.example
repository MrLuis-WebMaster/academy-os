DATABASE_URL="postgresql://academy:academy_local@localhost:5432/academy_os?schema=public"
PORT=3001
WEB_ORIGIN=http://localhost:5173
BETTER_AUTH_URL=http://localhost:5173
BETTER_AUTH_SECRET=REPLACE_WITH_32_OR_MORE_RANDOM_CHARACTERS
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional server-side AI integration: OFF by default.
# Never add a real API key to this file or GitHub.
ACADEMY_AI_ENABLED=false
ACADEMY_AI_MODEL=gpt-5-mini
OPENAI_API_KEY=

# Opt-in internal reminder delivery: only start the dedicated worker explicitly.
ACADEMY_IN_APP_REMINDERS_ENABLED=false

# Independent Google Calendar OAuth client. Keep off until configured.
GOOGLE_CALENDAR_ENABLED=false
GOOGLE_INTEGRATIONS_CLIENT_ID=
GOOGLE_INTEGRATIONS_CLIENT_SECRET=
# 32 random bytes encoded as 64 hexadecimal characters. Never commit a real key.
INTEGRATION_ENCRYPTION_KEY=

# Opt-in worker; requires Google Calendar enabled and explicit consent per class.
GOOGLE_CALENDAR_SYNC_WORKER_ENABLED=false

# Private educational file uploads: enable only in a controlled environment.
ACADEMY_PRIVATE_FILES_ENABLED=false

# Manual purchase requests. No gateway or automatic charge.
ACADEMY_PACKAGE_ORDERS_ENABLED=false

# Platform operator user IDs (verified accounts only); quota enforcement opt-in.
ACADEMY_PLATFORM_OPERATOR_IDS=
ACADEMY_SAAS_QUOTAS_ENABLED=false

# Pilot Wompi checkout — disabled until sandbox validated. Never commit keys.
ACADEMY_WOMPI_ENABLED=false
ACADEMY_WOMPI_LIVE_ENABLED=false
ACADEMY_WOMPI_ENVIRONMENT=test
ACADEMY_WOMPI_WORKSPACE_ID=
ACADEMY_WOMPI_PUBLIC_KEY=
ACADEMY_WOMPI_PRIVATE_KEY=
ACADEMY_WOMPI_INTEGRITY_KEY=
ACADEMY_WOMPI_EVENTS_KEY=
ACADEMY_WOMPI_ISSUER_ID=

ACADEMY_PAYMENT_RECONCILIATION_ENABLED=false

# Per-workspace Wompi sandbox configuration. Separate 32-byte hex encryption key.
ACADEMY_WORKSPACE_WOMPI_ENABLED=false
ACADEMY_MERCHANT_ENCRYPTION_KEY=
