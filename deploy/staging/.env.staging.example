# Copy to an UNTRACKED file on the staging server, never commit actual values.
# This is only a template; the example domain is not deployable.
STAGING_DOMAIN=academy.staging.example.com
STAGING_DB_PASSWORD=REPLACE_WITH_LONG_RANDOM_PASSWORD
# Password in DATABASE_URL must be percent-encoded when it contains reserved URI chars.
STAGING_DATABASE_URL=postgresql://academy:REPLACE_WITH_LONG_RANDOM_PASSWORD@postgres:5432/academy_os?schema=public
BETTER_AUTH_SECRET=REPLACE_WITH_32_OR_MORE_RANDOM_CHARACTERS
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ACADEMY_AI_ENABLED=false
ACADEMY_AI_MODEL=gpt-5-mini
OPENAI_API_KEY=
