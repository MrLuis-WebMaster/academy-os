generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum WorkspaceType {
  SOLO
  ACADEMY
}

enum MemberRole {
  OWNER
  ADMIN
  TEACHER
  STUDENT
  GUARDIAN
}

enum SessionMode {
  ONLINE
  ONSITE
  HYBRID
}

enum SessionStatus {
  DRAFT
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum ManualPaymentMethod {
  CASH
  BANK_TRANSFER
  OTHER
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum BookingStatus {
  BOOKED
  CANCELLED
}

enum ContentStatus {
  DRAFT
  REVIEW
  PUBLISHED
}

enum Provider {
  GOOGLE_CALENDAR
  GOOGLE_MEET
  ZOOM
  GOOGLE_DRIVE
  ONEDRIVE
  DROPBOX
}

enum ResourceSource {
  UPLOAD
  GOOGLE_DRIVE
  ONEDRIVE
  DROPBOX
  EXTERNAL_URL
}

model User {
  id          String           @id @default(cuid())
  email       String           @unique
  name        String
  emailVerified Boolean       @default(false)
  image       String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  sessions    Session[]
  accounts    Account[]
  setupRequests SetupRequest[]
  sentInvitations WorkspaceInvitation[] @relation("InvitedBy")
  bookings ClassBooking[]
  studentReceipts PaymentReceipt[] @relation("StudentPayment")
  recordedReceipts PaymentReceipt[] @relation("RecordedPayment")
  sessionChanges SessionChange[]
  notifications Notification[]
  classReminderPreferences ClassReminderPreference[]
  aiGenerations AiGeneration[]
  memberships WorkspaceMember[]
  teaching    TeacherProfile[]
  enrollments Enrollment[]
  submissions ActivityAttempt[]
  progress    SkillProgress[]
  skillEvidenceAsStudent SkillEvidence[] @relation("SkillEvidenceStudent")
  skillEvidenceAsReviewer SkillEvidence[] @relation("SkillEvidenceReviewer")
  assignedLearningGoals LearningGoal[] @relation("GoalAssigner")
  studentLearningGoals LearningGoal[] @relation("GoalStudent")
  guardianLinksAsGuardian GuardianLink[] @relation("GuardianIsGuardian")
  guardianLinksAsStudent GuardianLink[] @relation("GuardianIsStudent")
  guardianLinksRequested GuardianLink[] @relation("GuardianLinkRequester")
  guardianLinksApproved GuardianLink[] @relation("GuardianLinkApprover")
  sosReferralsAsStudent SosReferral[] @relation("SosReferralStudent")
  sosReferralsAsTeacher SosReferral[] @relation("SosReferralReviewer")
  studentPackageEntitlements ClassPackageEntitlement[] @relation("PackageStudent")
  issuedPackageEntitlements ClassPackageEntitlement[] @relation("PackageIssuer")
  revokedPackageEntitlements ClassPackageEntitlement[] @relation("PackageRevoker")
  createdLearningAssets LearningAsset[]
  connections ExternalConnection[]
  packageOrders PackageOrder[] @relation("PackageOrderStudent")
  reviewedPackageOrders PackageOrder[] @relation("PackageOrderReviewer")
}

model Workspace {
  id          String         @id @default(cuid())
  slug        String         @unique
  name        String
  type        WorkspaceType
  brandColor  String         @default("#7059e8")
  logoUrl     String?
  description String?
  contactUrl  String?
  publicEnabled Boolean      @default(false)
  timezone    String         @default("America/Bogota")
  holidayCountry String        @default("CO")
  avoidPublicHolidays Boolean  @default(false)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  members     WorkspaceMember[]
  teachers    TeacherProfile[]
  subjects    Subject[]
  courses     Course[]
  sessions    ClassSession[]
  resources   Resource[]
  connections ExternalConnection[]
  setupRequests SetupRequest[]
  invitations WorkspaceInvitation[]
  offerings Offering[]
  bookings ClassBooking[]
  paymentReceipts PaymentReceipt[]
  notifications Notification[]
  classReminderPreferences ClassReminderPreference[]
  availabilitySlots WeeklyAvailability[]
  timeOffPeriods TeacherTimeOff[]
  classSeries ClassSeries[]
  campuses Campus[]
  teachingRooms TeachingRoom[]
  aiGenerations AiGeneration[]
  skillEvidences SkillEvidence[]
  learningGoals LearningGoal[]
  guardianLinks GuardianLink[]
  teachingMethodologies TeachingMethodology[]
  sosReferrals SosReferral[]
  classPackages ClassPackage[]
  packageEntitlements ClassPackageEntitlement[]
  packageOrders PackageOrder[]
  wompiMerchant WompiMerchant?
  paymentEvents PaymentEventInbox[]
  saasSubscription SaasSubscription?
  saasPlanChanges SaasPlanChange[]
}

model WorkspaceMember {
  id          String     @id @default(cuid())
  workspaceId String
  userId      String
  role        MemberRole
  joinedAt    DateTime   @default(now())
  workspace   Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([workspaceId, userId, role])
  @@index([userId])
}

model TeacherProfile {
  id          String          @id @default(cuid())
  workspaceId String
  userId      String
  bio         String?
  workspace   Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  courses     CourseTeacher[]
  sessions    ClassSession[]
  availabilitySlots WeeklyAvailability[]
  timeOffPeriods TeacherTimeOff[]
  classSeries ClassSeries[]
  methodology TeachingMethodology?
  @@unique([workspaceId, userId])
}

model Subject {
  id          String     @id @default(cuid())
  workspaceId String
  name        String
  slug        String
  workspace   Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  courses     Course[]
  @@unique([workspaceId, slug])
}

model Course {
  id          String         @id @default(cuid())
  workspaceId String
  subjectId   String?
  title       String
  summary     String?
  published   Boolean        @default(false)
  requiresPackage Boolean @default(false)
  workspace   Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  subject     Subject?       @relation(fields: [subjectId], references: [id])
  teachers    CourseTeacher[]
  topics      Topic[]
  enrollments Enrollment[]
  learningGoals LearningGoal[]
  sosReferrals SosReferral[]
  sessions    ClassSession[]
  resources   Resource[]
  offerings Offering[]
  classPackages ClassPackage[]
  paymentReceipts PaymentReceipt[]
  @@index([workspaceId])
}

model CourseTeacher {
  courseId  String
  teacherId String
  course    Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  teacher   TeacherProfile @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  @@id([courseId, teacherId])
}

model Topic {
  id          String        @id @default(cuid())
  courseId    String
  parentId    String?
  title       String
  order       Int           @default(0)
  course      Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  parent      Topic?        @relation("TopicHierarchy", fields: [parentId], references: [id])
  children    Topic[]       @relation("TopicHierarchy")
  resources   Resource[]
  progress    SkillProgress[]
  evidences   SkillEvidence[]
  learningGoals LearningGoal[]
}

model Enrollment {
  id        String   @id @default(cuid())
  courseId  String
  userId    String
  createdAt DateTime @default(now())
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  student   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([courseId, userId])
}

model ClassSession {
  id          String        @id @default(cuid())
  workspaceId String
  courseId    String?
  teacherProfileId String?
  title       String
  mode        SessionMode
  status      SessionStatus @default(DRAFT)
  startsAt    DateTime
  endsAt      DateTime
  timezone    String
  capacity    Int           @default(1)
  location    String?
  provider    String?
  meetingUrl  String?
  externalId  String?
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  course      Course?       @relation(fields: [courseId], references: [id])
  teacher     TeacherProfile? @relation(fields: [teacherProfileId], references: [id])
  bookings ClassBooking[]
  changes SessionChange[]
  aiGenerations AiGeneration[]
  roomId String?
  room TeachingRoom? @relation(fields:[roomId],references:[id],onDelete:SetNull)
  seriesId String?
  seriesIndex Int?
  series ClassSeries? @relation(fields:[seriesId],references:[id],onDelete:SetNull)
  calendarSyncLinks CalendarSyncLink[]
  reflection  ClassReflection?
  resources   Resource[]
  @@index([workspaceId, startsAt])
  @@index([seriesId])
  @@index([roomId,startsAt])
}

model ClassReflection {
  id         String        @id @default(cuid())
  sessionId  String        @unique
  notes      String
  status     ContentStatus @default(DRAFT)
  approvedAt DateTime?
  session    ClassSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  activities Activity[]
  learningAssets LearningAsset[]
}

model Activity {
  id           String          @id @default(cuid())
  reflectionId String
  title        String
  questions    Json
  publishedAt  DateTime?
  reflection   ClassReflection @relation(fields: [reflectionId], references: [id], onDelete: Cascade)
  attempts     ActivityAttempt[]
  aiGenerations AiGeneration[]
}

model ActivityAttempt {
  id         String    @id @default(cuid())
  activityId String
  userId     String
  answers    Json
  score      Float?
  createdAt  DateTime  @default(now())
  activity   Activity  @relation(fields: [activityId], references: [id], onDelete: Cascade)
  student    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([activityId, userId])
}

model SkillProgress {
  topicId       String
  userId        String
  mastery       Float    @default(0)
  evidenceCount Int      @default(0)
  updatedAt     DateTime @updatedAt
  topic         Topic    @relation(fields: [topicId], references: [id], onDelete: Cascade)
  student       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@id([topicId, userId])
}

model Resource {
  id           String         @id @default(cuid())
  workspaceId  String
  courseId     String?
  sessionId    String?
  topicId      String?
  title        String
  source       ResourceSource
  externalId   String?
  url          String?
  aiAuthorized Boolean        @default(false)
  published    Boolean        @default(false)
  privateFile PrivateMaterialFile?
  workspace    Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  course       Course?        @relation(fields: [courseId], references: [id])
  session      ClassSession?  @relation(fields: [sessionId], references: [id])
  topic        Topic?         @relation(fields: [topicId], references: [id])
  @@index([workspaceId])
}

model ExternalConnection {
  id                String     @id @default(cuid())
  workspaceId       String
  userId            String
  provider          Provider
  externalAccountId String?
  secretReference   String?    // Secret-manager reference only: never raw OAuth tokens.
  encryptedCredentials String? @db.Text // AES-GCM encrypted provider credentials; never exposed by HTTP.
  connectedAt       DateTime   @default(now())
  workspace         Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user              User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([workspaceId, userId, provider])
  calendarSyncLinks CalendarSyncLink[]
}

// Required Better Auth 1.7 authentication records, separate from tenant roles.
model Session {
  id         String   @id
  token      String   @unique
  userId     String
  expiresAt  DateTime
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String   @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?  @db.Text
  refreshToken          String?  @db.Text
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  idToken               String?  @db.Text
  password              String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
  @@unique([providerId, accountId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String   @db.Text
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  @@index([identifier])
  @@map("verification")
}

model SetupRequest {
  id          String @id @default(cuid())
  userId      String
  requestId   String
  workspaceId String @unique
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, requestId])
}

model WorkspaceInvitation {
  id         String     @id @default(cuid())
  workspaceId String
  email      String
  role       MemberRole
  tokenHash  String     @unique
  createdBy  String
  expiresAt  DateTime
  acceptedAt DateTime?
  createdAt  DateTime   @default(now())
  workspace  Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  creator    User       @relation("InvitedBy", fields: [createdBy], references: [id], onDelete: Cascade)
  @@index([workspaceId, email])
}

model Offering {
  id String @id @default(cuid())
  workspaceId String
  courseId String?
  title String
  description String?
  priceCOP Int @default(0)
  durationMinutes Int @default(60)
  mode SessionMode @default(ONLINE)
  published Boolean @default(false)
  createdAt DateTime @default(now())
  workspace Workspace @relation(fields:[workspaceId], references:[id], onDelete:Cascade)
  course Course? @relation(fields:[courseId], references:[id])
  @@index([workspaceId,published])
}

model ClassBooking {
  id String @id @default(cuid())
  workspaceId String
  sessionId String
  userId String
  status BookingStatus @default(BOOKED)
  attendance AttendanceStatus?
  bookedAt DateTime @default(now())
  cancelledAt DateTime?
  workspace Workspace @relation(fields:[workspaceId],references:[id],onDelete:Cascade)
  session ClassSession @relation(fields:[sessionId],references:[id],onDelete:Cascade)
  student User @relation(fields:[userId],references:[id],onDelete:Cascade)
  packageRedemption ClassPackageRedemption?
  @@unique([sessionId,userId])
  @@index([workspaceId,status])
}

model PaymentReceipt {
  id String @id @default(cuid())
  workspaceId String
  courseId String?
  studentUserId String
  recordedByUserId String
  amountCOP Int
  method ManualPaymentMethod
  reference String?
  receivedAt DateTime @default(now())
  voidedAt DateTime?
  voidReason String?
  workspace Workspace @relation(fields:[workspaceId],references:[id],onDelete:Cascade)
  course Course? @relation(fields:[courseId],references:[id])
  student User @relation("StudentPayment",fields:[studentUserId],references:[id])
  recorder User @relation("RecordedPayment",fields:[recordedByUserId],references:[id])
  @@index([workspaceId,receivedAt])
}

model SessionChange {
  id String @id @default(cuid())
  sessionId String
  actorUserId String
  reason String
  oldStartsAt DateTime
  oldEndsAt DateTime
  newStartsAt DateTime
  newEndsAt DateTime
  changedAt DateTime @default(now())
  session ClassSession @relation(fields:[sessionId],references:[id],onDelete:Cascade)
  actor User @relation(fields:[actorUserId],references:[id])
  @@index([sessionId,changedAt])
}

model AiGeneration {
  id String @id @default(cuid())
  workspaceId String
  actorUserId String
  sessionId String
  activityId String?
  model String
  status String @default("PENDING")
  createdAt DateTime @default(now())
  workspace Workspace @relation(fields:[workspaceId],references:[id],onDelete:Cascade)
  actor User @relation(fields:[actorUserId],references:[id],onDelete:Cascade)
  session ClassSession @relation(fields:[sessionId],references:[id],onDelete:Cascade)
  activity Activity? @relation(fields:[activityId],references:[id],onDelete:SetNull)
  @@index([workspaceId,createdAt])
}

model WeeklyAvailability {
  id String @id @default(cuid())
  workspaceId String
  teacherProfileId String
  dayOfWeek Int
  startMinute Int
  endMinute Int
  workspace Workspace @relation(fields:[workspaceId],references:[id],onDelete:Cascade)
  teacher TeacherProfile @relation(fields:[teacherProfileId],references:[id],onDelete:Cascade)
  @@index([workspaceId,teacherProfileId,dayOfWeek])
}

model Notification {
  id String @id @default(cuid())
  workspaceId String
  userId String
  sessionId String?
  eventKey String
  kind String
  title String
  body String
  createdAt DateTime @default(now())
  readAt DateTime?
  workspace Workspace @relation(fields:[workspaceId],references:[id],onDelete:Cascade)
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  @@unique([workspaceId,userId,eventKey])
  @@index([workspaceId,userId,createdAt])
  @@index([workspaceId,userId,readAt])
}

model TeacherTimeOff {
  id String @id @default(cuid())
  workspaceId String
  teacherProfileId String
  createdByUserId String
  startsAt DateTime
  endsAt DateTime
  reason String
  createdAt DateTime @default(now())
  workspace Workspace @relation(fields:[workspaceId],references:[id],onDelete:Cascade)
  teacher TeacherProfile @relation(fields:[teacherProfileId],references:[id],onDelete:Cascade)
  @@index([workspaceId,teacherProfileId,startsAt,endsAt])
}

model ClassSeries {
  id String @id @default(cuid())
  workspaceId String
  teacherProfileId String
  createdByUserId String
  firstStartsAt DateTime
  repeatWeeks Int
  timezone String
  createdAt DateTime @default(now())
  workspace Workspace @relation(fields:[workspaceId],references:[id],onDelete:Cascade)
  teacher TeacherProfile @relation(fields:[teacherProfileId],references:[id],onDelete:Cascade)
  sessions ClassSession[]
  @@index([workspaceId,teacherProfileId,firstStartsAt])
}

model Campus {
  id String @id @default(cuid())
  workspaceId String
  name String
  address String
  active Boolean @default(true)
  createdAt DateTime @default(now())
  workspace Workspace @relation(fields:[workspaceId],references:[id],onDelete:Cascade)
  rooms TeachingRoom[]
  @@unique([workspaceId,name])
  @@index([workspaceId,active])
}

model TeachingRoom {
  id String @id @default(cuid())
  workspaceId String
  campusId String
  name String
  capacity Int @default(1)
  active Boolean @default(true)
  createdAt DateTime @default(now())
  workspace Workspace @relation(fields:[workspaceId],references:[id],onDelete:Cascade)
  campus Campus @relation(fields:[campusId],references:[id],onDelete:Cascade)
  sessions ClassSession[]
  @@unique([campusId,name])
  @@index([workspaceId,active])
}

model ClassReminderPreference {
  id String @id @default(cuid())
  workspaceId String
  userId String
  remind24h Boolean @default(false)
  remind1h Boolean @default(false)
  updatedAt DateTime @updatedAt
  workspace Workspace @relation(fields:[workspaceId],references:[id],onDelete:Cascade)
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  @@unique([workspaceId,userId])
  @@index([workspaceId,userId])
}

enum LearningGoalStatus {
  ACTIVE
  ACHIEVED
  CANCELLED
}

model SkillEvidence {
  id String @id @default(cuid())
  workspaceId String
  topicId String
  studentUserId String
  reviewerUserId String
  requestId String
  score Int
  note String
  createdAt DateTime @default(now())
  workspace Workspace @relation(fields:[workspaceId],references:[id],onDelete:Cascade)
  topic Topic @relation(fields:[topicId],references:[id],onDelete:Cascade)
  student User @relation("SkillEvidenceStudent",fields:[studentUserId],references:[id],onDelete:Cascade)
  reviewer User @relation("SkillEvidenceReviewer",fields:[reviewerUserId],references:[id])
  @@unique([workspaceId,reviewerUserId,requestId])
  @@index([workspaceId,studentUserId,topicId])
}

model LearningGoal {
  id String @id @default(cuid())
  workspaceId String
  courseId String
  topicId String?
  studentUserId String
  assignedByUserId String
  title String
  description String?
  targetMastery Int?
  targetAt DateTime?
  status LearningGoalStatus @default(ACTIVE)
  createdAt DateTime @default(now())
  completedAt DateTime?
  workspace Workspace @relation(fields:[workspaceId],references:[id],onDelete:Cascade)
  course Course @relation(fields:[courseId],references:[id],onDelete:Cascade)
  topic Topic? @relation(fields:[topicId],references:[id],onDelete:SetNull)
  student User @relation("GoalStudent",fields:[studentUserId],references:[id],onDelete:Cascade)
  assigner User @relation("GoalAssigner",fields:[assignedByUserId],references:[id])
  events LearningGoalEvent[]
  @@index([workspaceId,studentUserId,courseId,status])
}

model LearningGoalEvent {
  id String @id @default(cuid())
  goalId String
  actorUserId String
  fromStatus LearningGoalStatus
  toStatus LearningGoalStatus
  reason String
  createdAt DateTime @default(now())
  goal LearningGoal @relation(fields:[goalId],references:[id],onDelete:Cascade)
  @@index([goalId,createdAt])
}

enum GuardianLinkStatus {
  PENDING
  ACTIVE
  REVOKED
}

model GuardianLink {
  id String @id @default(cuid())
  workspaceId String
  guardianUserId String
  studentUserId String
  requestedByUserId String
  approvedByUserId String?
  status GuardianLinkStatus @default(PENDING)
  verificationMethod String?
  verificationNote String?
  approvedAt DateTime?
  revokedAt DateTime?
  createdAt DateTime @default(now())
  workspace Workspace @relation(fields:[workspaceId],references:[id],onDelete:Cascade)
  guardian User @relation("GuardianIsGuardian",fields:[guardianUserId],references:[id],onDelete:Cascade)
  student User @relation("GuardianIsStudent",fields:[studentUserId],references:[id],onDelete:Cascade)
  requester User @relation("GuardianLinkRequester",fields:[requestedByUserId],references:[id])
  approver User? @relation("GuardianLinkApprover",fields:[approvedByUserId],references:[id])
  events GuardianLinkEvent[]
  @@unique([workspaceId,guardianUserId,studentUserId])
  @@index([workspaceId,guardianUserId,status])
  @@index([workspaceId,studentUserId,status])
}

model GuardianLinkEvent {
  id String @id @default(cuid())
  linkId String
  actorUserId String
  fromStatus GuardianLinkStatus?
  toStatus GuardianLinkStatus
  reason String
  createdAt DateTime @default(now())
  link GuardianLink @relation(fields:[linkId],references:[id],onDelete:Cascade)
  @@index([linkId,createdAt])
}

enum TeachingSpecialty {
  GENERAL
  LANGUAGES
  MATHEMATICS
  MUSIC
  ART_DESIGN
  SCHOOL_SUPPORT
  EXAM_PREP
}

enum TeachingStyle {
  SOCRATIC
  STEP_BY_STEP
  CONVERSATIONAL
  PRACTICAL
  VISUAL
}

model TeachingMethodology {
  id String @id @default(cuid())
  workspaceId String
  teacherProfileId String @unique
  specialty TeachingSpecialty @default(GENERAL)
  style TeachingStyle @default(SOCRATIC)
  language String @default("es")
  guidance String @default("")
  sosEnabled Boolean @default(false)
  updatedAt DateTime @updatedAt
  workspace Workspace @relation(fields:[workspaceId],references:[id],onDelete:Cascade)
  teacher TeacherProfile @relation(fields:[teacherProfileId],references:[id],onDelete:Cascade)
  @@index([workspaceId])
}

enum SosReferralStatus {
 OPEN
 RESOLVED
}

model SosReferral {
 id String @id @default(cuid())
 workspaceId String
 courseId String
 studentUserId String
 question String
 status SosReferralStatus @default(OPEN)
 reply String?
 resolvedByUserId String?
 createdAt DateTime @default(now())
 resolvedAt DateTime?
 workspace Workspace @relation(fields:[workspaceId],references:[id],onDelete:Cascade)
 course Course @relation(fields:[courseId],references:[id],onDelete:Cascade)
 student User @relation("SosReferralStudent",fields:[studentUserId],references:[id],onDelete:Cascade)
 reviewer User? @relation("SosReferralReviewer",fields:[resolvedByUserId],references:[id])
 @@index([workspaceId,courseId,status,createdAt])
 @@index([workspaceId,studentUserId,createdAt])
}

/** Staff-issued class packages are prepaid credits recorded manually.
 * This is NOT proof of payment or integration with a card processor.
 */
model ClassPackage {
 id String @id @default(cuid())
 workspaceId String
 courseId String?
 courseRestricted Boolean @default(false)
 title String
 sessionCredits Int
 priceCOP Int
 validDays Int
 active Boolean @default(true)
 createdAt DateTime @default(now())
 workspace Workspace @relation(fields:[workspaceId],references:[id],onDelete:Cascade)
 course Course? @relation(fields:[courseId],references:[id])
 entitlements ClassPackageEntitlement[]
 orders PackageOrder[]
 @@index([workspaceId,active])
}

model ClassPackageEntitlement {
 id String @id @default(cuid())
 workspaceId String
 packageId String
 studentUserId String
 issuedByUserId String
 revokedByUserId String?
 revokeReason String?
 credits Int
 expiresAt DateTime
 issuedAt DateTime @default(now())
 requestId String @unique
 revokedAt DateTime?
 note String?
 workspace Workspace @relation(fields:[workspaceId],references:[id],onDelete:Cascade)
